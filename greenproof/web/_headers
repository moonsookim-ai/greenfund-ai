# Cache policy. Requires the zone's Browser Cache TTL to be set to
# "Respect Existing Headers" — a zone-level TTL overrides this file for
# standard static extensions (.js, .png ...), which is exactly how a stale
# module once took the production page down.

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/emissions/
  Cache-Control: no-cache

/nepal/
  Cache-Control: no-cache

/nepal/index.html
  Cache-Control: no-cache

/nepal/*.mjs
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=300

/nepal/data/*
  Cache-Control: no-cache

/nepal/style.css
  Cache-Control: public, max-age=300

/nepal/response.css
  Cache-Control: public, max-age=300

/nepal/rescue.css
  Cache-Control: public, max-age=300

/nepal/briefing.css
  Cache-Control: public, max-age=300

/nepal/handoff/
  Cache-Control: no-cache, no-transform

/nepal/handoff/index.html
  Cache-Control: no-cache, no-transform

/nepal/field/
  Cache-Control: no-cache, no-transform

/nepal/field/index.html
  Cache-Control: no-cache, no-transform

/nepal/images/*
  Cache-Control: public, max-age=86400

/lab.css
  Cache-Control: public, max-age=300

/site-header.css
  Cache-Control: public, max-age=300

/data/*
  Cache-Control: public, max-age=300

/emissions/data/*
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=86400

/emissions/og.png
  Cache-Control: public, max-age=86400
